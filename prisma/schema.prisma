generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique @map("correo")
  phone     String?  @unique @map("telefono")
  dni       String?  @unique
  fullName  String   @map("nombre_completo")
  passwordHash String @map("contrasena_hash")

  isActive  Boolean  @default(true) @map("esta_activo")

  // Brute-force / account lockout
  failedLoginAttempts Int       @default(0) @map("intentos_fallidos")
  lockedUntil         DateTime? @map("bloqueado_hasta")

  refreshTokens RefreshToken[]
  loginEvents   LoginEvent[]
  faceReference FaceReference?
  account       Account?

  createdAt DateTime @default(now()) @map("creado_en")
  updatedAt DateTime @updatedAt @map("actualizado_en")

  @@map("usuarios")
}

model RefreshToken {
  id         String    @id @default(uuid())
  userId     String    @map("usuario_id")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Never store the raw token, only a hash of it
  tokenHash  String    @unique @map("token_hash")

  userAgent  String?   @map("agente_usuario")
  ip         String?

  expiresAt  DateTime  @map("expira_en")
  revokedAt  DateTime? @map("revocado_en")
  replacedByTokenHash String? @map("reemplazado_por_token_hash")

  createdAt  DateTime  @default(now()) @map("creado_en")

  @@index([userId])
  @@map("tokens_renovacion")
}

enum LoginEventResult {
  SUCCESS
  INVALID_CREDENTIALS
  ACCOUNT_LOCKED
  ACCOUNT_INACTIVE

  @@map("resultado_inicio_sesion")
}

model LoginEvent {
  id        String            @id @default(uuid())
  userId    String?           @map("usuario_id")
  user      User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  email     String            @map("correo")
  result    LoginEventResult  @map("resultado")
  ip        String?
  userAgent String?           @map("agente_usuario")
  createdAt DateTime          @default(now()) @map("creado_en")

  @@index([userId])
  @@index([email])
  @@map("eventos_inicio_sesion")
}

enum OtpPurpose {
  REGISTER
  PASSWORD_RESET

  @@map("proposito_otp")
}

model EmailOtp {
  id         String     @id @default(uuid())
  email      String     @map("correo")
  purpose    OtpPurpose @map("proposito")

  // Never store the raw code, only a hash of it
  codeHash   String     @map("codigo_hash")
  attempts   Int        @default(0) @map("intentos")

  expiresAt  DateTime   @map("expira_en")
  consumedAt DateTime?  @map("consumido_en")
  createdAt  DateTime   @default(now()) @map("creado_en")

  @@index([email, purpose])
  @@map("codigos_verificacion")
}

// Reference photos for biometric Face ID login — captured once during
// registration (with explicit user consent) and stored in Cloudinary; only
// the resulting URLs live here. Every later Face ID login compares a fresh
// selfie against these instead of being stored itself.
model FaceReference {
  id              String   @id @default(uuid())
  userId          String   @unique @map("usuario_id")
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  dniPhotoUrl     String   @map("foto_dni_url")
  selfiePhotoUrl  String   @map("foto_selfie_url")
  createdAt       DateTime @default(now()) @map("creado_en")
  updatedAt       DateTime @updatedAt @map("actualizado_en")

  @@map("referencias_faciales")
}

// Audit trail for the one-time registration face-match check — the photos
// used there are compared in-memory against Face++ and discarded (unlike
// FaceReference above, which is a deliberate saved copy for later logins).
model FaceVerificationEvent {
  id         String   @id @default(uuid())
  dni        String
  matched    Boolean  @map("coincidio")
  confidence Float    @map("confianza")
  ip         String?
  userAgent  String?  @map("agente_usuario")
  createdAt  DateTime @default(now()) @map("creado_en")

  @@index([dni])
  @@map("eventos_verificacion_facial")
}

// The real internal ledger backing the Home screen — balances and account
// numbers live here, generated once at registration. This never moves real
// money through any bank; it's a self-contained ledger inside NovaBank
// itself (see conversation: real interbank transfers require an SBS
// license, which is out of reach for a personal project).
model Account {
  id               String   @id @default(uuid())
  userId           String   @unique @map("usuario_id")
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  accountNumber    String   @unique @map("numero_cuenta")
  cci              String   @unique
  cardNumber       String   @map("numero_tarjeta")
  cardExpiry       String   @map("vencimiento_tarjeta")

  availableBalance Decimal  @default(0) @db.Decimal(12, 2) @map("saldo_disponible")
  heldBalance      Decimal  @default(0) @db.Decimal(12, 2) @map("saldo_retenido")
  creditLine       Decimal  @default(0) @db.Decimal(12, 2) @map("linea_credito")
  cardDebt         Decimal  @default(0) @db.Decimal(12, 2) @map("deuda_tarjeta")
  cutDay           Int      @default(28) @map("dia_corte")
  cardBlocked      Boolean  @default(false) @map("tarjeta_bloqueada")

  transactions     Transaction[]

  createdAt DateTime @default(now()) @map("creado_en")
  updatedAt DateTime @updatedAt @map("actualizado_en")

  @@map("cuentas")
}

enum TransactionKind {
  CREDIT
  DEBIT

  @@map("tipo_transaccion")
}

enum TransactionCategory {
  COMPRAS
  TRANSFERENCIAS
  QR
  INGRESOS
  RETIROS
  SERVICIOS

  @@map("categoria_transaccion")
}

model Transaction {
  id        String              @id @default(uuid())
  accountId String              @map("cuenta_id")
  account   Account             @relation(fields: [accountId], references: [id], onDelete: Cascade)

  kind      TransactionKind     @map("tipo")
  category  TransactionCategory @map("categoria")
  name      String              @map("nombre")
  meta      String
  amount    Decimal             @db.Decimal(12, 2) @map("monto")
  icon      String
  iconBg    String              @map("icono_fondo")
  iconFg    String              @map("icono_color")

  createdAt DateTime            @default(now()) @map("creado_en")

  @@index([accountId, createdAt])
  @@map("transacciones")
}
