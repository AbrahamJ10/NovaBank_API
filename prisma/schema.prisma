generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique @map("correo")
  phone     String?  @unique @map("telefono")
  dni       String?  @unique
  fullName  String   @map("nombre_completo")
  passwordHash String @map("contrasena_hash")

  isActive  Boolean  @default(true) @map("esta_activo")

  // Bloqueo de cuenta por fuerza bruta
  failedLoginAttempts Int       @default(0) @map("intentos_fallidos")
  lockedUntil         DateTime? @map("bloqueado_hasta")

  // Preferencias de notificación — se revisan en cada punto de uso antes de
  // crear una fila de Notification (alertPurchase en qr.service.payQr,
  // alertWithdraw en withdrawals.service create/cancelWithdrawal, alertLogin
  // en auth.service.registerSuccess); alertPromo todavía no tiene ninguna
  // función de promociones que controlar. La transacción del historial nunca
  // se filtra, solo la notificación.
  alertPurchase Boolean @default(true)  @map("alerta_compra")
  alertWithdraw Boolean @default(true)  @map("alerta_retiro")
  alertLogin    Boolean @default(true)  @map("alerta_login")
  alertPromo    Boolean @default(false) @map("alerta_promo")

  refreshTokens RefreshToken[]
  loginEvents   LoginEvent[]
  faceReference FaceReference?
  account       Account?
  notifications Notification[]
  payees        Payee[]
  bills         Bill[]
  withdrawals   Withdrawal[]
  auditLogs     AuditLog[]

  createdAt DateTime @default(now()) @map("creado_en")
  updatedAt DateTime @updatedAt @map("actualizado_en")

  @@map("usuarios")
}

model RefreshToken {
  id         String    @id @default(uuid())
  userId     String    @map("usuario_id")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Nunca se guarda el token en crudo, solo su hash
  tokenHash  String    @unique @map("token_hash")

  userAgent  String?   @map("agente_usuario")
  ip         String?

  expiresAt  DateTime  @map("expira_en")
  revokedAt  DateTime? @map("revocado_en")
  replacedByTokenHash String? @map("reemplazado_por_token_hash")

  createdAt  DateTime  @default(now()) @map("creado_en")

  @@index([userId])
  @@map("tokens_renovacion")
}

enum LoginEventResult {
  SUCCESS
  INVALID_CREDENTIALS
  ACCOUNT_LOCKED
  ACCOUNT_INACTIVE

  @@map("resultado_inicio_sesion")
}

model LoginEvent {
  id        String            @id @default(uuid())
  userId    String?           @map("usuario_id")
  user      User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  email     String            @map("correo")
  result    LoginEventResult  @map("resultado")
  ip        String?
  userAgent String?           @map("agente_usuario")
  createdAt DateTime          @default(now()) @map("creado_en")

  @@index([userId])
  @@index([email])
  @@map("eventos_inicio_sesion")
}

enum OtpPurpose {
  REGISTER
  PASSWORD_RESET
  TRANSFER
  PROFILE_UPDATE

  @@map("proposito_otp")
}

model EmailOtp {
  id         String     @id @default(uuid())
  email      String     @map("correo")
  purpose    OtpPurpose @map("proposito")

  // Nunca se guarda el código en crudo, solo su hash
  codeHash   String     @map("codigo_hash")
  attempts   Int        @default(0) @map("intentos")

  expiresAt  DateTime   @map("expira_en")
  consumedAt DateTime?  @map("consumido_en")
  createdAt  DateTime   @default(now()) @map("creado_en")

  @@index([email, purpose])
  @@map("codigos_verificacion")
}

// Cuenta los intentos fallidos de un código OTP por correo+propósito, sin
// importar cuántos códigos nuevos se hayan pedido mientras tanto — así un
// código nuevo no resetea el conteo de intentos. Al llegar al máximo, se
// bloquea la verificación de ese correo+propósito por un tiempo, en vez de
// solo pedir un código nuevo.
model BloqueoOtp {
  id             String     @id @default(uuid())
  correo         String
  proposito      OtpPurpose
  intentos       Int        @default(0)
  bloqueadoHasta DateTime?  @map("bloqueado_hasta")
  actualizadoEn  DateTime   @updatedAt @map("actualizado_en")

  @@unique([correo, proposito])
  @@map("bloqueos_otp")
}

// Fotos de referencia para el login biométrico con Face ID — se capturan una
// sola vez durante el registro (con consentimiento explícito del usuario) y
// se guardan en Cloudinary; aquí solo viven las URLs resultantes. Cada login
// con Face ID posterior compara una selfie nueva contra estas, en vez de
// guardar la selfie en sí.
model FaceReference {
  id              String   @id @default(uuid())
  userId          String   @unique @map("usuario_id")
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  dniPhotoUrl     String   @map("foto_dni_url")
  selfiePhotoUrl  String   @map("foto_selfie_url")
  createdAt       DateTime @default(now()) @map("creado_en")
  updatedAt       DateTime @updatedAt @map("actualizado_en")

  @@map("referencias_faciales")
}

// Registro de auditoría de la verificación facial única del registro — las
// fotos usadas ahí se comparan en memoria contra Face++ y se descartan (a
// diferencia de FaceReference arriba, que es una copia guardada a propósito
// para logins posteriores).
model FaceVerificationEvent {
  id         String   @id @default(uuid())
  dni        String
  matched    Boolean  @map("coincidio")
  confidence Float    @map("confianza")
  ip         String?
  userAgent  String?  @map("agente_usuario")
  createdAt  DateTime @default(now()) @map("creado_en")

  @@index([dni])
  @@map("eventos_verificacion_facial")
}

// El libro contable interno real detrás de la pantalla de Inicio — aquí
// viven los saldos y números de cuenta, generados una sola vez en el
// registro. Esto nunca mueve dinero real a través de ningún banco; es un
// libro contable autocontenido dentro de NovaBank mismo (las transferencias
// interbancarias reales requieren una licencia de la SBS, fuera del alcance
// de un proyecto personal).
model Account {
  id               String   @id @default(uuid())
  userId           String   @unique @map("usuario_id")
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  accountNumber    String   @unique @map("numero_cuenta")
  cci              String   @unique
  cardNumber       String   @map("numero_tarjeta")
  cardExpiry       String   @map("vencimiento_tarjeta")
  cardCvv          String   @map("cvv_tarjeta")

  availableBalance Decimal  @default(0) @db.Decimal(12, 2) @map("saldo_disponible")
  heldBalance      Decimal  @default(0) @db.Decimal(12, 2) @map("saldo_retenido")
  creditLine       Decimal  @default(0) @db.Decimal(12, 2) @map("linea_credito")
  cardDebt         Decimal  @default(0) @db.Decimal(12, 2) @map("deuda_tarjeta")
  cutDay           Int      @default(28) @map("dia_corte")
  cardBlocked      Boolean  @default(false) @map("tarjeta_bloqueada")

  // Límites de gasto/controles geográficos. limitOnline se aplica en las
  // transferencias (la única salida real de dinero); los interruptores de
  // limitAtm/geo se guardan para la pantalla de Límites pero aún no se
  // aplican — el retiro sin tarjeta todavía no está conectado al libro
  // contable real.
  limitOnline      Decimal  @default(1500) @db.Decimal(12, 2) @map("limite_en_linea")
  limitAtm         Decimal  @default(700)  @db.Decimal(12, 2) @map("limite_cajero")
  geoPeru          Boolean  @default(true)  @map("geo_peru")
  geoIntl          Boolean  @default(false) @map("geo_internacional")

  transactions     Transaction[]
  withdrawals      Withdrawal[]

  createdAt DateTime @default(now()) @map("creado_en")
  updatedAt DateTime @updatedAt @map("actualizado_en")

  @@map("cuentas")
}

enum TransactionKind {
  CREDIT
  DEBIT

  @@map("tipo_transaccion")
}

enum TransactionCategory {
  COMPRAS
  TRANSFERENCIAS
  QR
  INGRESOS
  RETIROS
  SERVICIOS
  PAGO_TARJETA

  @@map("categoria_transaccion")
}

model Transaction {
  id        String              @id @default(uuid())
  accountId String              @map("cuenta_id")
  account   Account             @relation(fields: [accountId], references: [id], onDelete: Cascade)

  kind      TransactionKind     @map("tipo")
  category  TransactionCategory @map("categoria")
  name      String              @map("nombre")
  meta      String
  amount    Decimal             @db.Decimal(12, 2) @map("monto")
  icon      String              @map("icono")
  iconBg    String              @map("icono_fondo")
  iconFg    String              @map("icono_color")

  createdAt DateTime            @default(now()) @map("creado_en")

  @@index([accountId, createdAt])
  @@map("transacciones")
}

// Notificaciones reales asociadas al titular de la cuenta — se crean del
// lado del servidor cada vez que pasa algo digno de notificar (llega una
// transacción, se dispara un evento de seguridad). Están ligadas al usuario
// y no a la cuenta porque no toda notificación tiene forma de transacción.
model Notification {
  id        String   @id @default(uuid())
  userId    String   @map("usuario_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  title     String   @map("titulo")
  body      String   @map("cuerpo")
  icon      String   @map("icono")
  iconBg    String   @map("icono_fondo")
  iconFg    String   @map("icono_color")
  unread    Boolean  @default(true) @map("no_leido")

  createdAt DateTime @default(now()) @map("creado_en")

  @@index([userId, createdAt])
  @@map("notificaciones")
}

// Un beneficiario de transferencia guardado. "inactive" refleja las razones
// de rechazo reales de un banco (cuenta destino cerrada/congelada) — el
// endpoint de transferencia se niega a mover dinero hacia uno en vez de
// tener éxito en silencio.
model Payee {
  id            String   @id @default(uuid())
  userId        String   @map("usuario_id")
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  name          String   @map("nombre")
  bank          String   @map("banco")
  accountNumber String   @map("numero_cuenta")
  initials      String   @map("iniciales")
  inactive      Boolean  @default(false) @map("inactivo")

  createdAt     DateTime @default(now()) @map("creado_en")

  @@index([userId])
  @@map("beneficiarios")
}

enum BillerCategory {
  LUZ
  AGUA
  GAS
  MOVIL
  CABLE
  BANCO
  SEGURO
  EDUCACION
  MUNICIPALIDAD

  @@map("categoria_proveedor")
}

// El directorio real de proveedores de servicio a los que un usuario puede
// afiliar un servicio (ver Bill abajo) — una tabla de referencia global, no
// datos por usuario, sembrada una sola vez a través de prisma/seed.ts.
model Biller {
  id               String         @id @default(uuid())
  key              String         @unique @map("clave")
  name             String         @map("nombre")
  category         BillerCategory @map("categoria")
  icon             String         @map("icono")
  iconBg           String         @map("icono_fondo")
  iconFg           String         @map("icono_color")
  fieldLabel       String         @map("etiqueta_campo")
  fieldPlaceholder String         @map("placeholder_campo")
  active           Boolean        @default(true) @map("activo")

  bills            Bill[]

  createdAt        DateTime       @default(now()) @map("creado_en")

  @@map("proveedores_servicio")
}

// Una fila = un servicio afiliado (proveedor + número de suministro/línea) Y
// su ciclo de facturación actual. Pagarlo solo cambia paid=true — el
// siguiente ciclo no es una fila nueva; listBills() de forma perezosa
// regresa una fila pagada y vencida a paid=false una vez que su ciclo
// terminó, el mismo efecto que un recibo recurrente real sin necesitar un
// cron job.
model Bill {
  id           String   @id @default(uuid())
  userId       String   @map("usuario_id")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  billerKey    String   @map("proveedor")
  biller       Biller   @relation(fields: [billerKey], references: [key])
  supplyNumber String   @map("numero_suministro")

  name        String   @map("nombre")
  meta        String
  icon        String   @map("icono")
  amount      Decimal  @db.Decimal(12, 2) @map("monto")
  dueDate     DateTime @map("fecha_vencimiento")
  consumption String?  @map("consumo")
  paid        Boolean  @default(false) @map("pagado")
  paidAt      DateTime? @map("pagado_en")
  suspended   Boolean  @default(false) @map("suspendido")

  createdAt   DateTime @default(now()) @map("creado_en")

  @@unique([userId, billerKey, supplyNumber])
  @@index([userId, paid, dueDate])
  @@map("servicios")
}

enum AuditCategory {
  SESION
  NAVEGACION
  TRANSFERENCIA
  PAGO_SERVICIO
  RETIRO
  TARJETA
  QR
  PERFIL
  SEGURIDAD

  @@map("categoria_auditoria")
}

// El rastro completo de interacción: toda acción de seguridad o movimiento
// de dinero se escribe aquí del lado del servidor (el servicio que la
// ejecuta también llama a audit.service.recordAudit, ver por ejemplo
// transfers.service.executeTransfer); la navegación puramente del lado del
// cliente (vistas de pantalla, toques de botón sin una llamada propia al
// backend) la reporta la app en lotes a través de POST /api/audit/events.
// A propósito es genérico (action + metadata en JSON) en vez de una columna
// por tipo de evento, ya que el alcance pedido abarca desde un toque de
// botón hasta una transferencia completada — category acota lo suficiente
// para consultar con eficiencia, metadata lleva lo específico de cada acción
// (beneficiario, monto, nombre de pantalla, clave del proveedor, etc).
//
// country/city son un cálculo aproximado a partir de la IP de la solicitud
// (ver lib/requestMeta.ts) — eso da una ubicación a nivel país/ciudad, no un
// ubigeo peruano preciso (departamento/provincia/distrito), que
// necesitaría que la app pida permiso de GPS y no está implementado.
model AuditLog {
  id          String        @id @default(uuid())
  userId      String?       @map("usuario_id")
  user        User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  category    AuditCategory @map("categoria")
  action      String        @map("accion")
  success     Boolean       @default(true) @map("exitoso")

  description String?       @map("descripcion")
  metadata    Json?         @map("metadatos")

  screen      String?       @map("pantalla")

  ip          String?
  country     String?       @map("pais")
  city        String?       @map("ciudad")
  device      String?       @map("dispositivo")
  platform    String?       @map("plataforma")
  appVersion  String?       @map("version_app")

  createdAt   DateTime      @default(now()) @map("creado_en")

  @@index([userId, createdAt])
  @@index([category, createdAt])
  @@index([action])
  @@map("auditoria")
}

// Una clave de retiro sin tarjeta. El monto se debita de inmediato cuando se
// genera la clave (aquí no hay una red de cajeros real contra la cual
// canjearla después) — cancelarla antes de que expire la reembolsa con una
// transacción de crédito real, igual que revertir cualquier otro débito
// real.
model Withdrawal {
  id         String    @id @default(uuid())
  userId     String    @map("usuario_id")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId  String    @map("cuenta_id")
  account    Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)

  code       String    @unique @map("codigo")
  amount     Decimal   @db.Decimal(12, 2) @map("monto")
  expiresAt  DateTime  @map("expira_en")
  cancelledAt DateTime? @map("cancelado_en")

  createdAt  DateTime  @default(now()) @map("creado_en")

  @@index([userId])
  @@map("retiros_sin_tarjeta")
}
