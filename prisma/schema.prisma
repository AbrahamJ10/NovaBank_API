generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  phone     String?  @unique
  dni       String?  @unique
  fullName  String
  passwordHash String

  isActive  Boolean  @default(true)

  // Brute-force / account lockout
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?

  refreshTokens RefreshToken[]
  loginEvents   LoginEvent[]
  faceReference FaceReference?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model RefreshToken {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Never store the raw token, only a hash of it
  tokenHash  String    @unique

  userAgent  String?
  ip         String?

  expiresAt  DateTime
  revokedAt  DateTime?
  replacedByTokenHash String?

  createdAt  DateTime  @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

enum LoginEventResult {
  SUCCESS
  INVALID_CREDENTIALS
  ACCOUNT_LOCKED
  ACCOUNT_INACTIVE
}

model LoginEvent {
  id        String            @id @default(uuid())
  userId    String?
  user      User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  email     String
  result    LoginEventResult
  ip        String?
  userAgent String?
  createdAt DateTime          @default(now())

  @@index([userId])
  @@index([email])
  @@map("login_events")
}

enum OtpPurpose {
  REGISTER
}

model EmailOtp {
  id         String     @id @default(uuid())
  email      String
  purpose    OtpPurpose

  // Never store the raw code, only a hash of it
  codeHash   String
  attempts   Int        @default(0)

  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime   @default(now())

  @@index([email, purpose])
  @@map("email_otps")
}

// Reference photos for biometric Face ID login — captured once during
// registration (with explicit user consent) and stored in Cloudinary; only
// the resulting URLs live here. Every later Face ID login compares a fresh
// selfie against these instead of being stored itself.
model FaceReference {
  id              String   @id @default(uuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  dniPhotoUrl     String
  selfiePhotoUrl  String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("face_references")
}

// Audit trail for the one-time registration face-match check — the photos
// used there are compared in-memory against Face++ and discarded (unlike
// FaceReference above, which is a deliberate saved copy for later logins).
model FaceVerificationEvent {
  id         String   @id @default(uuid())
  dni        String
  matched    Boolean
  confidence Float
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([dni])
  @@map("face_verification_events")
}
