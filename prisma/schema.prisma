generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique @map("correo")
  phone     String?  @unique @map("telefono")
  dni       String?  @unique
  fullName  String   @map("nombre_completo")
  passwordHash String @map("contrasena_hash")

  isActive  Boolean  @default(true) @map("esta_activo")

  // Brute-force / account lockout
  failedLoginAttempts Int       @default(0) @map("intentos_fallidos")
  lockedUntil         DateTime? @map("bloqueado_hasta")

  // Notification preferences — which events actually create a Notification
  // row for this user (see notifications.service.shouldNotify).
  alertPurchase Boolean @default(true)  @map("alerta_compra")
  alertWithdraw Boolean @default(true)  @map("alerta_retiro")
  alertLogin    Boolean @default(true)  @map("alerta_login")
  alertPromo    Boolean @default(false) @map("alerta_promo")

  refreshTokens RefreshToken[]
  loginEvents   LoginEvent[]
  faceReference FaceReference?
  account       Account?
  notifications Notification[]
  payees        Payee[]
  bills         Bill[]
  withdrawals   Withdrawal[]

  createdAt DateTime @default(now()) @map("creado_en")
  updatedAt DateTime @updatedAt @map("actualizado_en")

  @@map("usuarios")
}

model RefreshToken {
  id         String    @id @default(uuid())
  userId     String    @map("usuario_id")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Never store the raw token, only a hash of it
  tokenHash  String    @unique @map("token_hash")

  userAgent  String?   @map("agente_usuario")
  ip         String?

  expiresAt  DateTime  @map("expira_en")
  revokedAt  DateTime? @map("revocado_en")
  replacedByTokenHash String? @map("reemplazado_por_token_hash")

  createdAt  DateTime  @default(now()) @map("creado_en")

  @@index([userId])
  @@map("tokens_renovacion")
}

enum LoginEventResult {
  SUCCESS
  INVALID_CREDENTIALS
  ACCOUNT_LOCKED
  ACCOUNT_INACTIVE

  @@map("resultado_inicio_sesion")
}

model LoginEvent {
  id        String            @id @default(uuid())
  userId    String?           @map("usuario_id")
  user      User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  email     String            @map("correo")
  result    LoginEventResult  @map("resultado")
  ip        String?
  userAgent String?           @map("agente_usuario")
  createdAt DateTime          @default(now()) @map("creado_en")

  @@index([userId])
  @@index([email])
  @@map("eventos_inicio_sesion")
}

enum OtpPurpose {
  REGISTER
  PASSWORD_RESET
  TRANSFER
  PROFILE_UPDATE

  @@map("proposito_otp")
}

model EmailOtp {
  id         String     @id @default(uuid())
  email      String     @map("correo")
  purpose    OtpPurpose @map("proposito")

  // Never store the raw code, only a hash of it
  codeHash   String     @map("codigo_hash")
  attempts   Int        @default(0) @map("intentos")

  expiresAt  DateTime   @map("expira_en")
  consumedAt DateTime?  @map("consumido_en")
  createdAt  DateTime   @default(now()) @map("creado_en")

  @@index([email, purpose])
  @@map("codigos_verificacion")
}

// Reference photos for biometric Face ID login — captured once during
// registration (with explicit user consent) and stored in Cloudinary; only
// the resulting URLs live here. Every later Face ID login compares a fresh
// selfie against these instead of being stored itself.
model FaceReference {
  id              String   @id @default(uuid())
  userId          String   @unique @map("usuario_id")
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  dniPhotoUrl     String   @map("foto_dni_url")
  selfiePhotoUrl  String   @map("foto_selfie_url")
  createdAt       DateTime @default(now()) @map("creado_en")
  updatedAt       DateTime @updatedAt @map("actualizado_en")

  @@map("referencias_faciales")
}

// Audit trail for the one-time registration face-match check — the photos
// used there are compared in-memory against Face++ and discarded (unlike
// FaceReference above, which is a deliberate saved copy for later logins).
model FaceVerificationEvent {
  id         String   @id @default(uuid())
  dni        String
  matched    Boolean  @map("coincidio")
  confidence Float    @map("confianza")
  ip         String?
  userAgent  String?  @map("agente_usuario")
  createdAt  DateTime @default(now()) @map("creado_en")

  @@index([dni])
  @@map("eventos_verificacion_facial")
}

// The real internal ledger backing the Home screen — balances and account
// numbers live here, generated once at registration. This never moves real
// money through any bank; it's a self-contained ledger inside NovaBank
// itself (see conversation: real interbank transfers require an SBS
// license, which is out of reach for a personal project).
model Account {
  id               String   @id @default(uuid())
  userId           String   @unique @map("usuario_id")
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  accountNumber    String   @unique @map("numero_cuenta")
  cci              String   @unique
  cardNumber       String   @map("numero_tarjeta")
  cardExpiry       String   @map("vencimiento_tarjeta")
  cardCvv          String   @map("cvv_tarjeta")

  availableBalance Decimal  @default(0) @db.Decimal(12, 2) @map("saldo_disponible")
  heldBalance      Decimal  @default(0) @db.Decimal(12, 2) @map("saldo_retenido")
  creditLine       Decimal  @default(0) @db.Decimal(12, 2) @map("linea_credito")
  cardDebt         Decimal  @default(0) @db.Decimal(12, 2) @map("deuda_tarjeta")
  cutDay           Int      @default(28) @map("dia_corte")
  cardBlocked      Boolean  @default(false) @map("tarjeta_bloqueada")

  // Spending limits/geo-controls. limitOnline is enforced on transfers (the
  // one real money-out path); limitAtm/geo toggles are stored for the
  // Limits screen but not enforced yet — cardless withdrawal isn't wired to
  // the real ledger.
  limitOnline      Decimal  @default(1500) @db.Decimal(12, 2) @map("limite_en_linea")
  limitAtm         Decimal  @default(700)  @db.Decimal(12, 2) @map("limite_cajero")
  geoPeru          Boolean  @default(true)  @map("geo_peru")
  geoIntl          Boolean  @default(false) @map("geo_internacional")

  transactions     Transaction[]
  withdrawals      Withdrawal[]

  createdAt DateTime @default(now()) @map("creado_en")
  updatedAt DateTime @updatedAt @map("actualizado_en")

  @@map("cuentas")
}

enum TransactionKind {
  CREDIT
  DEBIT

  @@map("tipo_transaccion")
}

enum TransactionCategory {
  COMPRAS
  TRANSFERENCIAS
  QR
  INGRESOS
  RETIROS
  SERVICIOS
  PAGO_TARJETA

  @@map("categoria_transaccion")
}

model Transaction {
  id        String              @id @default(uuid())
  accountId String              @map("cuenta_id")
  account   Account             @relation(fields: [accountId], references: [id], onDelete: Cascade)

  kind      TransactionKind     @map("tipo")
  category  TransactionCategory @map("categoria")
  name      String              @map("nombre")
  meta      String
  amount    Decimal             @db.Decimal(12, 2) @map("monto")
  icon      String
  iconBg    String              @map("icono_fondo")
  iconFg    String              @map("icono_color")

  createdAt DateTime            @default(now()) @map("creado_en")

  @@index([accountId, createdAt])
  @@map("transacciones")
}

// Real notifications tied to the account holder — created server-side
// whenever something notification-worthy happens (a transaction lands,
// a security event fires). Tied to the user rather than the account
// since not every notification is transaction-shaped.
model Notification {
  id        String   @id @default(uuid())
  userId    String   @map("usuario_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  title     String   @map("titulo")
  body      String   @map("cuerpo")
  icon      String
  iconBg    String   @map("icono_fondo")
  iconFg    String   @map("icono_color")
  unread    Boolean  @default(true) @map("no_leido")

  createdAt DateTime @default(now()) @map("creado_en")

  @@index([userId, createdAt])
  @@map("notificaciones")
}

// A saved transfer beneficiary. "inactive" mirrors a real bank's own
// rejection reasons (closed/frozen destination account) — the transfer
// endpoint refuses to move money to one instead of silently succeeding.
model Payee {
  id            String   @id @default(uuid())
  userId        String   @map("usuario_id")
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  name          String
  bank          String
  accountNumber String   @map("numero_cuenta")
  initials      String
  inactive      Boolean  @default(false)

  createdAt     DateTime @default(now()) @map("creado_en")

  @@index([userId])
  @@map("beneficiarios")
}

enum BillerCategory {
  LUZ
  AGUA
  GAS
  MOVIL
  CABLE
  BANCO
  SEGURO
  EDUCACION
  MUNICIPALIDAD

  @@map("categoria_proveedor")
}

// The real directory of billers a user can affiliate a service with (see
// Bill below) — a global reference table, not per-user data, seeded once
// via prisma/seed.ts.
model Biller {
  id               String         @id @default(uuid())
  key              String         @unique
  name             String
  category         BillerCategory
  icon             String
  iconBg           String         @map("icono_fondo")
  iconFg           String         @map("icono_color")
  fieldLabel       String         @map("etiqueta_campo")
  fieldPlaceholder String         @map("placeholder_campo")
  active           Boolean        @default(true)

  bills            Bill[]

  createdAt        DateTime       @default(now()) @map("creado_en")

  @@map("proveedores_servicio")
}

// One row = one affiliated service (biller + supply/line number) AND its
// current billing cycle. Paying it just flips paid=true — the next cycle
// isn't a new row; listBills() lazily rolls a stale paid row back to
// paid=false once its cycle's elapsed, same effect as a real recurring
// bill without needing a cron job.
model Bill {
  id           String   @id @default(uuid())
  userId       String   @map("usuario_id")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  billerKey    String   @map("proveedor")
  biller       Biller   @relation(fields: [billerKey], references: [key])
  supplyNumber String   @map("numero_suministro")

  name        String
  meta        String
  icon        String
  amount      Decimal  @db.Decimal(12, 2)
  dueDate     DateTime @map("fecha_vencimiento")
  consumption String?
  paid        Boolean  @default(false) @map("pagado")
  paidAt      DateTime? @map("pagado_en")
  suspended   Boolean  @default(false) @map("suspendido")

  createdAt   DateTime @default(now()) @map("creado_en")

  @@unique([userId, billerKey, supplyNumber])
  @@index([userId, paid, dueDate])
  @@map("servicios")
}

// A cardless-withdrawal code. The amount is debited immediately when the
// code is generated (there's no real ATM network here to redeem against
// later) — cancelling before it expires refunds it with a real credit
// transaction, same as reversing any other real debit.
model Withdrawal {
  id         String    @id @default(uuid())
  userId     String    @map("usuario_id")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId  String    @map("cuenta_id")
  account    Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)

  code       String    @unique
  amount     Decimal   @db.Decimal(12, 2)
  expiresAt  DateTime  @map("expira_en")
  cancelledAt DateTime? @map("cancelado_en")

  createdAt  DateTime  @default(now()) @map("creado_en")

  @@index([userId])
  @@map("retiros_sin_tarjeta")
}
