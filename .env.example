NODE_ENV=development
PORT=3000

# Postgres connection string (Neon, Render Postgres, etc.)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Comma-separated list of allowed origins for CORS (the mobile app doesn't send
# an Origin header, this is mainly for the future admin web dashboard)
CORS_ORIGIN="http://localhost:19006"

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET="replace-me"
JWT_REFRESH_SECRET="replace-me"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"

# Required — AES-256-GCM key for Account.cardNumber/cardCvv at rest.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY="replace-me-64-char-hex"

# RENIEC DNI lookup (https://decolecta.com) — optional, /api/dni/:dni 503s without it
DNI_PROVIDER_TOKEN=""

# Face++ face comparison for Face ID login/registration (https://faceplusplus.com) — optional
FACEPP_API_KEY=""
FACEPP_API_SECRET=""
FACEPP_API_BASE="https://api-us.faceplusplus.com"

# Transactional email — at least one of Brevo or Resend is required for OTP
# codes/statements/receipts to actually send; Brevo is tried first.
RESEND_API_KEY=""
RESEND_FROM="NovaBank <onboarding@resend.dev>"

BREVO_API_KEY=""
BREVO_FROM_EMAIL=""

# Cloudinary, for storing Face ID reference photos (https://cloudinary.com) — optional
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
